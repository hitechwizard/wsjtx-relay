{
  "name": "wsjtx-relay",
  "version": "1.1.1",
  "description": "WSJT-X Relay runs as a middle-man between WSJT-X and applications that consume WSJT-X UDP packets. It also has a fairly extensive QSO Editor allowing the user to import/export ADIF files. This simplifies operating during a POTA Activation and creating logs for upload.",
  "license": "BSD-3-Clause",
  "main": "src/main.js",
  "author": "Jesse Jarrell - W1BBT",
  "homepage": "https://github.com/hitechwizard/wsjtx-relay",
  "preload": "src/preload.js",
  "scripts": {
    "start": "electron .",
    "start:debug": "electron --inspect=9229 .",
    "start:debug-brk": "electron --inspect-brk=9229 .",
    "start:devtools": "electron --auto-open-devtools-for-tabs .",
    "start:trace": "electron --enable-logging .",
    "format": "prettier --write .",
    "lint": "eslint . --ext .js,.jsx,.cjs,.mjs,.ts,.tsx,.cts,.mts --fix",
    "generate-icon": "node scripts/generate-icon.js",
    "dev": "electron --no-sandbox .",
    "postinstall": "electron-builder install-app-deps",
    "build:unpack": "electron-builder --dir",
    "build:win": "electron-builder --win",
    "build:mac": "electron-builder --mac",
    "build:linux": "electron-builder --linux",
    "build:arm": "electron-builder --armv7l --arm64",
    "build:arm64": "electron-builder --arm64",
    "build:all": "electron-builder --win --mac --linux",
    "publish": "node scripts/publish.js",
    "publish:all": "node scripts/publish.js --all"
  },
  "dependencies": {
    "dateformat": "^5.0.3",
    "electron-store": "^11.0.2",
    "electron-updater": "^6.8.9"
  },
  "devDependencies": {
    "@electron-toolkit/eslint-config": "^2.1.0",
    "electron": "^43.0.0",
    "electron-builder": "^26.15.3",
    "png-to-ico": "^3.0.1",
    "sharp": "^0.35.3"
  },
  "build": {
    "appId": "net.hitechwizard.wsjtxrelay",
    "productName": "WSJT-X Relay",
    "win": {
      "icon": "assets/icon.ico",
      "artifactName": "wsjtx-relay-${version}-${os}-${arch}.${ext}"
    },
    "mac": {
      "artifactName": "wsjtx-relay-${version}-${os}-${arch}.${ext}",
      "target": [
        "default"
      ],
      "type": "distribution",
      "hardenedRuntime": true,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "icon": "assets/icon.png"
    },
    "linux": {
      "artifactName": "wsjtx-relay-${version}-${os}-${arch}.${ext}",
      "icon": "assets/icon.png"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "hitechwizard",
        "repo": "wsjtx-relay"
      }
    ],
    "files": [
      "src/**",
      "ui/**",
      "assets/**"
    ]
  }
}
